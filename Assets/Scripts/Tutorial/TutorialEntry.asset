  m_Script: {fileID: 11500000, guid: 1422c03e1ba9c014fb24d9393cd983ce, type: 3}
  m_Name: TutorialEntry
  m_EditorClassIdentifier: 
  lines:
  - text: Eieieiei has vist aixo?
    cameraPointIndex: -1
    cameraHoldSeconds: 2
  - text: El drac ha perdut els colors!
    cameraPointIndex: 0
    cameraHoldSeconds: 2
  - text: Flipant eh
    cameraPointIndex: -1
    cameraHoldSeconds: 2
  - text: Es veu que des de que l'han portat d'orient esta algo trist...
    cameraPointIndex: -1
    cameraHoldSeconds: 2
  - text: Ahir va estar plorant i va perdre els colors del seu trencadis
    cameraPointIndex: -1
    cameraHoldSeconds: 2
  - text: Mira quin desastre! Estan tots per terra!
    cameraPointIndex: -1
    cameraHoldSeconds: 2
  - text: Estem cansades! No parem de canviar de color!
    cameraPointIndex: 1
    cameraHoldSeconds: 2
  - text: Si us plau, alliverans i fes que deixem anar el color per poder ser lliures!
    cameraPointIndex: -1
    cameraHoldSeconds: 2
  - text: Aquella font de alla em sembla que et dona alguna pista...
    cameraPointIndex: -1
    cameraHoldSeconds: 2
  - text: Estas preparat? Doncs aveure si ens atrapes!
    cameraPointIndex: -1
    cameraHoldSeconds: 2
